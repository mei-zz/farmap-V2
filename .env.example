# Safe local configuration template. Put real values only in ignored .env files.
VITE_API_BASE_URL=
VITE_RAG_MODE=mock
VITE_AGENT_MODE=mock
VITE_ENABLE_DEMO_MODE=true

# Weather: free keyless forecast fallback; Gaode is preferred when configured.
GAODE_API_KEY=
OPEN_METEO_API_ENABLED=true
OPEN_METEO_API_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
OPEN_METEO_CONNECT_TIMEOUT_MS=5000
OPEN_METEO_READ_TIMEOUT_MS=10000

# Alibaba Cloud Model Studio / Bailian
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
# Existing local aliases are also supported by the backend launcher.
APIKEY=
BASEURL=
BAILIAN_REGION=beijing
BAILIAN_WORKSPACE_ID=
BAILIAN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
FARMAP_MODEL_ROUTER_ENABLED=true
FARMAP_DEFAULT_MODEL=qwen-plus-2025-07-28
# Low-cost model for ordinary Copilot Q&A; verified fallbacks remain server-owned.
FARMAP_FAST_MODEL=qwen-flash
FARMAP_MULTIMODAL_MODEL=qwen3-vl-32b-thinking
RAG_GENERATION_MODE=qwen
FARMAP_KNOWLEDGE_EMBEDDING_PROVIDER=bailian
FARMAP_KNOWLEDGE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
FARMAP_KNOWLEDGE_EMBEDDING_DIMENSION=1024
# true: allow clearly labelled general agricultural answers without grounding;
# false: fail closed when neither private facts nor knowledge evidence exists.
FARMAP_COPILOT_ALLOW_UNGROUNDED=true
FARMAP_AI_GLOBAL_MAX_OUTPUT_TOKENS=8192
FARMAP_COPILOT_MAX_OUTPUT_TOKENS=2048
FARMAP_DIAGNOSIS_MAX_OUTPUT_TOKENS=3072
# Copilot history: latest turns plus a bounded server-owned summary.
FARMAP_COPILOT_MEMORY_MAX_RECENT_TURNS=10
FARMAP_COPILOT_MEMORY_MAX_CONTEXT_CHARS=4000
FARMAP_AGENT_PLANNER_MODEL_ENABLED=false
FARMAP_AGENT_PERSISTENCE=mysql
FARMAP_DIAGNOSIS_MAX_CONCURRENT_JOBS=2
FARMAP_DIAGNOSIS_QUEUE_CAPACITY=8
FARMAP_AGENT_MAX_STEPS=8
FARMAP_AGENT_MAX_TOOL_CALLS=12
FARMAP_AGENT_TIMEOUT_MS=120000

# Backend / model services
LOCAL_AI_BASE_URL=http://127.0.0.1:8001
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
OPENAI_API_KEY=
HUNYUAN_API_KEY=
API_KEYS=

# Hikvision / HikCloud. The legacy pair powers live preview; remote camera
# capture additionally requires Cloud Open API credentials from open2.hik-cloud.com.
HIKYUN_ACCESS_KEY=
HIKYUN_SECRET_KEY=
HIKYUN_PRODUCT_CODE=
HIKYUN_PROJECT_ID=
HIKYUN_CLIENT_ID=
HIKYUN_CLIENT_SECRET=

# Tencent Cloud COS for browser-captured monitor frames.
# Keep SecretId/SecretKey in the ignored local .env only; never commit them.
TENCENT_COS_ENABLED=true
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-chongqing
TENCENT_COS_BUCKET=farmap-1317766785
# Leave blank for a private bucket; set the bucket domain only when public read is intended.
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_PREFIX=farmap/diagnosis
