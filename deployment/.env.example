MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MONGO_ROOT_PASSWORD=replace-with-random-password
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-random-secret-key
MODEL_API_KEY=replace-with-random-internal-key
JWT_SECRET=replace-with-at-least-32-random-characters
HUNYUAN_API_KEY=replace-with-provider-key
HUNYUAN_TEXT_MODEL=hunyuan-a13b
DASHSCOPE_API_KEY=replace-with-provider-key
BAILIAN_API_KEY=
BAILIAN_REGION=beijing
BAILIAN_WORKSPACE_ID=
BAILIAN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
FARMAP_MODEL_ROUTER_ENABLED=true
RAG_GENERATION_MODE=template
# true: allow clearly labelled general agricultural answers without grounding;
# false: fail closed when neither private facts nor knowledge evidence exists.
FARMAP_COPILOT_ALLOW_UNGROUNDED=true
FARMAP_AI_GLOBAL_MAX_OUTPUT_TOKENS=8192
FARMAP_COPILOT_MAX_OUTPUT_TOKENS=2048
FARMAP_DIAGNOSIS_MAX_OUTPUT_TOKENS=3072
# Copilot history: latest turns plus a bounded server-owned summary.
FARMAP_COPILOT_MEMORY_MAX_RECENT_TURNS=10
FARMAP_COPILOT_MEMORY_MAX_CONTEXT_CHARS=4000
GAODE_API_KEY=replace-with-provider-key
HIKYUN_ACCESS_KEY=replace-with-provider-key
HIKYUN_SECRET_KEY=replace-with-provider-secret
HIKYUN_PRODUCT_CODE=replace-with-product-code
HIKYUN_PROJECT_ID=replace-with-project-id
