# Frontend local configuration template. Copy to .env.development (ignored)
# and fill real values; never commit real keys.

# Safe local-only product demo. The code also requires import.meta.env.DEV.
VITE_ENABLE_DEMO_MODE=true

# Gaode (AMap) browser key used by index.html. Apply for your own key at
# https://lbs.amap.com/ and keep it out of git.
VITE_GAODE_API_KEY=

# Backend base URL for local development; leave empty to use the dev proxy.
VITE_API_BASE_URL=
