  "architecture": {
    "controlPlane": "Spring Boot owns auth, Farm/Field context, persistence, product loop, approvals, operations and audit",
    "intelligencePlane": "Python owns multimodal model calls, embedding and optional ASR; no business writes or identity generation",
    "dataPlane": [
      "MySQL canonical business facts",
      "object storage/upload references",
      "Milvus versioned vector indexes",
      "Mongo only if HistoricalCase metadata ownership is explicitly retained"
    ],
    "contextRule": "server assembles and authorizes context from IDs; frontend supplies intent and references only",
    "failureRule": "UNAVAILABLE != EMPTY != STALE; fail closed on persistence/model dependency failures",
    "nextPhase": "Phase B — Python Contract & Runtime"
  },
