      "measured": true
    },
    "realProvider": {
      "description": "Live model quality is outside the default offline suite. A zero denominator means no live-provider claim is made.",
      "status": "NOT_RUN",
      "denominator": 0,
      "reason": "Requires an explicitly configured provider; the evaluation never reads credentials from .env."
    }
  },
